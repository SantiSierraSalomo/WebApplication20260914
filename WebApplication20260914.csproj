    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>PromotionManager</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
